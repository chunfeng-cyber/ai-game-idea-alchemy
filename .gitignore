# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cloudflared-*.log
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
/.npm-cache/

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
.alchemy-runtime/
public/generated/
/.openai/
/worker-configuration.d.ts
*.tsbuildinfo
/test-results/
/playwright-report/

# Local agent memories and historical review artifacts contain personal paths
# and embedded reference images; keep only the public release-readiness docs.
/.agents/
/Docs/features/*/
!/Docs/features/open-source-readiness/

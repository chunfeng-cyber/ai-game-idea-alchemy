# Optional first-run defaults. Both services can instead be configured in the UI.
# Saved .alchemy-runtime/provider-settings.json takes precedence.
# Never commit keys or copy them into browser scripts.
ALCHEMY_PROVIDER_MODE=api
ALCHEMY_FALLBACK_MODE=none

# Text: OpenAI-compatible Chat Completions or Anthropic Messages.
# Fill a model your own provider and account can actually call.
ALCHEMY_CHAT_API_BASE_URL=https://api.openai.com/v1
ALCHEMY_CHAT_API_KEY=
ALCHEMY_CHAT_API_FORMAT=openai
ALCHEMY_CHAT_MODEL=
ALCHEMY_CHAT_MAX_TOKENS=4096
ALCHEMY_CHAT_TEMPERATURE=0.75
ALCHEMY_CHAT_TIMEOUT_MS=180000
# Image: OpenAI-compatible Images Generations or Echojoy task API.
# The key and model are independent of the text service.
ALCHEMY_IMAGE_API_BASE_URL=https://api.openai.com/v1
ALCHEMY_IMAGE_API_KEY=
ALCHEMY_IMAGE_API_FORMAT=openai
ALCHEMY_IMAGE_MODEL=
ALCHEMY_IMAGE_SIZE=1536x1024
ALCHEMY_IMAGE_QUALITY=medium
ALCHEMY_IMAGE_TIMEOUT_MS=300000
# Echojoy-specific options; ignored by the OpenAI image protocol.
ALCHEMY_IMAGE_RESOLUTION=1K
ALCHEMY_POLL_INTERVAL_MS=2000

# This release uses fixed ports; changing just one is not supported.
# PORT=3000
# ALCHEMY_CODEX_PORT=3002

# Optional Chinese poster font override (system CJK fonts are detected automatically).
# ALCHEMY_FONT_FILE=/absolute/path/to/NotoSansCJK-Regular.ttc
# ALCHEMY_FONT_FAMILY=Noto Sans CJK SC

# Legacy shared ALCHEMY_API_KEY / ALCHEMY_API_BASE_URL remain supported in code.
# New installations should use the independent fields above.
